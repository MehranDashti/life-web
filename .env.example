APP_NAME=LifeWeb
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:9900
APP_VERSION=dev

# Persian-first API: messages, validation errors, and report day boundaries.
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lifeweb
DB_USERNAME=lifeweb
DB_PASSWORD=secret

# Host-side ports for the containers. Deliberately non-standard so they don't
# collide with a MySQL/Redis already running on the developer's machine.
# DB_HOST/REDIS_HOST above are the in-network names and are unaffected.
APP_PORT=9900
DB_FORWARD_PORT=33306
REDIS_FORWARD_PORT=63790
ES_FORWARD_PORT=9200
DB_ROOT_PASSWORD=root

# --- Cache / queue / session --------------------------------------------------
# The queue is the scaling seam: report generation is one job per report, so
# throughput scales by adding queue workers (`docker compose up --scale queue=N`).
CACHE_STORE=redis
# Both must be stores shared across application instances. A per-process store
# gives every container its own rate-limit bucket and a near-useless queue lock.
CACHE_LIMITER_STORE=redis
CACHE_LOCK_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# predis on the host, which has no phpredis extension. The container overrides
# this to phpredis in docker-compose.yml, where the extension is installed.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# --- Elasticsearch ------------------------------------------------------------
SEARCH_DRIVER=elasticsearch

# Collapses identical aggregations issued in the same scheduler tick into one
# engine call. Invalidated exactly by a corpus version, with the TTL as backstop.
# This reduces load on Elasticsearch; it does not reduce single-request latency.
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_STORE=redis
SEARCH_CACHE_TTL=900
SEARCH_CACHE_COUNT_TTL=60
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX_ALIAS=posts
ELASTICSEARCH_INDEX_PATTERN=posts-*
ELASTICSEARCH_TEMPLATE_NAME=posts-template
ELASTICSEARCH_SHARDS=1
ELASTICSEARCH_REPLICAS=0
ELASTICSEARCH_CHUNK_SIZE=1000
ELASTICSEARCH_RETRIES=2
ELASTICSEARCH_REQUEST_TIMEOUT=30

# --- Passport -----------------------------------------------------------------
# Generated by `php artisan passport:keys`. Leave empty to read them from
# storage/oauth-*.key instead of the environment.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# --- Reporting ----------------------------------------------------------------
# Report buckets are calendar days in this timezone; the corpus is Persian news,
# so Tehran local days are the meaningful unit rather than UTC days.
REPORT_TIMEZONE=Asia/Tehran
# Filesystem DRIVER for the generated workbooks disk: local or s3.
REPORT_DISK_DRIVER=local

# Delivery is deliberately not fully implemented (out of scope per the task);
# `log` writes the rendered mail to the log so the flow is observable.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="reports@lifeweb.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Octane -------------------------------------------------------------------
OCTANE_SERVER=swoole
OCTANE_WORKERS=8

# Elasticsearch heap. 1g is fine for the supplied corpus; the benchmark sweep
# needs more headroom to index a million documents on a single node.
ES_JAVA_OPTS="-Xms2g -Xmx2g"

# Requests per minute per authenticated user (per IP when anonymous).
# NOTE: the capacity benchmark raises this — every virtual user shares one token
# and therefore one bucket, so leaving it at 120 would measure the rate limiter
# rather than the API. See the README's benchmark method.
API_RATE_LIMIT=120
