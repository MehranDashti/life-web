<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         failOnDeprecation="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Hits real infrastructure (Elasticsearch). Excluded from the default run
             and from CI's fast gate; run explicitly with `make integration`. -->
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>

    <php>
        <!--
            APP_ENV is the ONLY variable set here, and it has to be: Laravel reads
            it before bootstrapping to decide which env file to load, and
            `.env.testing` is only picked up when it says `testing`.

            Everything else lives in .env.testing. PHPUnit sets these before Dotenv
            runs, and Dotenv will not overwrite an existing variable — so any value
            duplicated here would silently win and make .env.testing decorative.
        -->
        <env name="APP_ENV" value="testing"/>
    </php>
</phpunit>
