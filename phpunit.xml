<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         failOnDeprecation="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Hits real infrastructure (Elasticsearch). Excluded from the default run
             and from CI's fast gate; run explicitly with `make integration`. -->
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_LOCALE" value="fa"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>

        <!-- Only the schema is overridden. Host, port and credentials come from
             .env locally and from the real environment in CI, so the same file
             works against a forwarded container port and against a CI service. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="lifeweb_testing"/>

        <!-- The array store supports cache tags, which QueryCacheable relies on. -->
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="MAIL_MAILER" value="array"/>

        <!-- In-memory search double: unit and feature tests never need a live
             Elasticsearch. Integration tests override this to `elasticsearch`. -->
        <env name="SEARCH_DRIVER" value="fake"/>
        <env name="REPORT_TIMEZONE" value="Asia/Tehran"/>
    </php>
</phpunit>
