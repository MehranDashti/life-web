# ---------------------------------------------------------------------------
# Test environment
# ---------------------------------------------------------------------------
#
# Laravel loads this file INSTEAD OF .env whenever APP_ENV=testing, which
# phpunit.xml sets. It therefore has to be self-sufficient, APP_KEY included.
#
# Real environment variables still win over anything here, which is deliberate
# and is what lets one file serve three places:
#
#   host      (make ci)   -> the values below; MySQL on the forwarded port
#   container (make test) -> docker-compose sets DB_HOST=mysql, DB_PORT=3306
#   CI                    -> the workflow env block sets host, port and creds
#
# Committed on purpose: it holds no secrets, and CI and every contributor need
# the same test configuration.
# ---------------------------------------------------------------------------

APP_NAME=LifeWeb
APP_ENV=testing

# Fixed rather than generated: the suite must not depend on a key-generation
# step, and this key protects nothing.
APP_KEY=base64:rypak1Eb4ld3Cqlc3jPez8kgFJjXbT2YnCpxZuGcee0=

APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=UTC
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Cost 4 rather than 12. The suite hashes passwords constantly, and the bcrypt
# work factor would otherwise dominate the run time.
BCRYPT_ROUNDS=4

# --- Database ---------------------------------------------------------------
# A dedicated schema, so a test run can never truncate development data.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33306
DB_DATABASE=lifeweb_testing
DB_USERNAME=lifeweb
DB_PASSWORD=secret

# --- Everything in-process --------------------------------------------------
# Nothing below touches a network service, so the Unit and Feature suites need
# no infrastructure beyond the database.
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Off by default, so a warm cache can never mask a real assertion. The suite
# that exercises the cached read path turns it back on explicitly.
QUERY_CACHE_ENABLED=false

API_RATE_LIMIT=120

# --- Search -----------------------------------------------------------------
# The in-memory double. Only tests/Integration overrides this to elasticsearch,
# and it connects to the host below.
SEARCH_DRIVER=fake
ELASTICSEARCH_HOSTS=http://127.0.0.1:9200
ELASTICSEARCH_INDEX_ALIAS=posts
ELASTICSEARCH_INDEX_PATTERN=posts-*
ELASTICSEARCH_TEMPLATE_NAME=posts-template
ELASTICSEARCH_SHARDS=1
ELASTICSEARCH_REPLICAS=0
ELASTICSEARCH_CHUNK_SIZE=1000

# --- Reporting --------------------------------------------------------------
REPORT_TIMEZONE=Asia/Tehran
REPORT_DISK_DRIVER=local
