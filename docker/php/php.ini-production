memory_limit = 512M
max_execution_time = 120
post_max_size = 32M
upload_max_filesize = 32M
expose_php = Off
display_errors = Off
log_errors = On
error_log = /dev/stderr
date.timezone = UTC

opcache.enable = 1
opcache.enable_cli = 1
opcache.memory_consumption = 256
opcache.max_accelerated_files = 20000
opcache.validate_timestamps = 0
opcache.jit_buffer_size = 64M
opcache.jit = tracing

; Report generation streams rows, so a large corpus must not need a large heap.
; If this ever needs raising, the export is buffering when it should stream.
